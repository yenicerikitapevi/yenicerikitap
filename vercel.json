{
  "functions": {
    "**/*.php": {
      "runtime": "vercel-php@0.6.0"
    }
  },
  "routes": [
    { "src": "/admin/(isbn_lookup|isbn_cover)\\.php", "dest": "/admin/$1.php" },
    { "src": "/admin/isbn_helper/(isbn-helper|html5-qrcode\\.min)\\.js", "dest": "/admin/isbn_helper/$1.js" },
    { "src": "/track\\.php", "dest": "/track.php" },
    { "src": "/satici/?", "dest": "/satici/index.php" },
    { "src": "/satici/(login|logout|index)\\.php", "dest": "/satici/$1.php" },
    { "src": "/admin/(.*)", "dest": "/admin/index.php?p=$1" },
    { "src": "/admin", "dest": "/admin/index.php" },
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/(.*)", "dest": "/index.php" }
  ]
}
