{
  "version": 2,
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.6.0"
    },
    "*.php": {
      "runtime": "vercel-php@0.6.0"
    },
    "admin/*.php": {
      "runtime": "vercel-php@0.6.0"
    }
  },
  "routes": [
    { "src": "/admin/(.*)", "dest": "/admin/index.php?p=$1" },
    { "src": "/admin", "dest": "/admin/index.php" },
    { "src": "/detail.php", "dest": "/detail.php" },
    { "src": "/category.php", "dest": "/category.php" },
    { "src": "/checkout.php", "dest": "/checkout.php" },
    { "src": "/contact.php", "dest": "/contact.php" },
    { "src": "/blog.php", "dest": "/blog.php" },
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/(.*)", "dest": "/index.php" }
  ]
}
